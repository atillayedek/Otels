# Supabase proje adresi ve yayınlanabilir (publishable) anahtar — tarayıcıya açık olması güvenlidir; erişim RLS ile sınırlanır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sitenin genel adresi (sitemap ve bağlantılar için), örn. https://otelpms.tsdmr.com
NEXT_PUBLIC_SITE_URL=

# Ön sipariş kötüye kullanım sınırı için IP özetinde kullanılan gizli tuz (en az 32 rastgele karakter). Sunucuda kalır.
CLIENT_KEY_SALT=

# KVKK aydınlatma metnindeki veri sorumlusu iletişim bilgileri (boş bırakılırsa ilgili satır gösterilmez).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
