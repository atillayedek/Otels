{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TSDMR Restoran",
  "version": "1.0.0",
  "identifier": "com.tsdmr.restaurant",
  "build": {
    "frontendDist": "../../desktop-client/dist-restaurant"
  },
  "app": {
    "windows": [
      {
        "title": "TSDMR Restoran",
        "width": 420,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TSDMR Digital Studio",
    "copyright": "© TSDMR Digital Studio",
    "category": "Business",
    "shortDescription": "Restoran adisyon uygulaması",
    "longDescription": "Otelin yerel PMS sunucusuna bağlanan garson adisyon uygulaması.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
